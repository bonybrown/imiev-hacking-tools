<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <RootNamespace>download_miev_firmware</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Set to match your J2534 DLL architecture -->
    <!-- Most adapters (OpenPort, GODIAG, Sardine) are 32-bit; requires 32-bit .NET 10 runtime -->
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="J2534-Sharp.Core" Version="2.0.4" />
    <PackageReference Include="System.CommandLine" Version="2.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\Kwp2000.cs" Link="Kwp2000.cs" />
    <Compile Include="..\shared\CanAddress.cs" Link="CanAddress.cs" />
  </ItemGroup>

</Project>
